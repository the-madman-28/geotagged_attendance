{
  "expo": {
    "name": "Geotagged Attendance",
    "slug": "geotagged-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "geotaggedattendance",
    "ios": {
  "supportsTablet": true,
  "bundleIdentifier": "com.madman28.geotaggedattendance",
  "infoPlist": {
    "NSLocationWhenInUseUsageDescription": "Your location is used to verify that you are at the workplace when marking attendance."
  }
},
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.madman28.geotaggedattendance"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Your location is used to verify your workplace location when marking attendance."
        }
      ],
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "d8ededc6-65bd-444c-9e59-f6ba29f04fe8"
      }
    }
  }
}
