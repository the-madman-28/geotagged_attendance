generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  IN_RANGE
  OUT_OF_RANGE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  admins     Admin[]
  employees  Employee[]
  workplaces Workplace[]
  attendance Attendance[]
  devices    EmployeeDevice[]

  @@map("organizations")
}

model Admin {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("admins")
}

model Employee {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  devices    EmployeeDevice[]
  attendance Attendance[]

  @@unique([organizationId, employeeId])
  @@index([organizationId])
  @@map("employees")
}

model EmployeeDevice {
  id               String   @id @default(uuid())
  organizationId   String
  deviceId         String
  employeeId       String
  registrationDate DateTime @db.Date
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, deviceId, registrationDate])
  @@index([organizationId])
  @@index([employeeId])
  @@index([deviceId, registrationDate])
  @@map("employee_devices")
}

model Workplace {
  id                  String   @id @default(uuid())
  organizationId      String
  name                String
  latitude            Decimal  @db.Decimal(10, 7)
  longitude           Decimal  @db.Decimal(10, 7)
  radiusMeters        Decimal  @db.Decimal(10, 2)
  maximumSessionHours Decimal  @db.Decimal(5, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  attendance Attendance[]

  @@index([organizationId])
  @@map("workplaces")
}

model Attendance {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  workplaceId    String
  attendanceDate DateTime

  // Punch In
  punchIn          DateTime
  punchInLatitude  Decimal          @db.Decimal(10, 7)
  punchInLongitude Decimal          @db.Decimal(10, 7)
  punchInAccuracy  Decimal          @db.Decimal(10, 2)
  punchInDistance  Decimal          @db.Decimal(10, 2)
  punchInStatus    AttendanceStatus
  punchInReason    String?

  // Punch Out
  punchOut          DateTime?
  punchOutLatitude  Decimal?          @db.Decimal(10, 7)
  punchOutLongitude Decimal?          @db.Decimal(10, 7)
  punchOutAccuracy  Decimal?          @db.Decimal(10, 2)
  punchOutDistance  Decimal?          @db.Decimal(10, 2)
  punchOutStatus    AttendanceStatus?
  punchOutReason    String?

  // Automatic Punch Out
  autoPunchedOut Boolean @default(false)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  workplace    Workplace    @relation(fields: [workplaceId], references: [id])

  @@unique([organizationId, employeeId, attendanceDate])
  @@index([organizationId])
  @@index([employeeId])
  @@index([workplaceId])
  @@index([attendanceDate])
  @@map("attendance")
}
